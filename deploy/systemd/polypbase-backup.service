[Unit]
Description=Polypbase PostgreSQL backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=polypbase_backup
Group=polypbase_backup
ExecStart=/usr/local/libexec/polypbase-deployment-backup
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
RestrictSUIDSGID=true
UMask=0077
