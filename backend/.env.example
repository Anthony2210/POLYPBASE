# Local development example, not a deployment or QA configuration.
# Copy only to an ignored local backend/.env. Never commit or display real values.
# Optional settings are commented out. Keep external services disabled locally.

# Local HTTP development only. Production defaults to DEBUG off and requires a
# new private, randomly generated DJANGO_SECRET_KEY (except for Django tests).
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# React app URL used for QR codes and links, not the Django server URL.
PUBLIC_BASE_URL=http://localhost:5173

# Optional diagnostics: log API requests over 500 ms by route name, with
# query count and cumulative SQL execution time. Off by default.
# POLYPBASE_LOG_SLOW_API=1

# With POSTGRES_DB absent or empty the ordinary app uses local db.sqlite3.
# Uncomment only for an explicitly verified database (not Neon or production
# for development or QA). For test isolation use explicit Django settings.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# HTTPS defaults when not running with DEBUG or the Django test command.
# Keep redirects enabled in production and configure the trusted proxy.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=86400
# Keep subdomain policy and preload off unless separately reviewed.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0

# Use the console backend with delivery disabled locally. SMTP settings below
# are optional defaults/placeholders; use approved private configuration for SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_DELIVERY_ENABLED=0
DEFAULT_FROM_EMAIL="Polypbase <noreply@example.invalid>"
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=10

# Password reset link lifetime (seconds) and auth throttling defaults.
# DJANGO_PASSWORD_RESET_TIMEOUT=3600
# AUTH_LOGIN_IP_MAX_FAILURES=10
# AUTH_LOGIN_IP_WINDOW_SECONDS=900
# AUTH_LOGIN_IP_BLOCK_SECONDS=900
# AUTH_LOGIN_ACCOUNT_MAX_FAILURES=20
# AUTH_LOGIN_ACCOUNT_WINDOW_SECONDS=3600
# AUTH_LOGIN_ACCOUNT_BLOCK_SECONDS=1800
# AUTH_RESET_IP_MAX_REQUESTS=5
# AUTH_RESET_IP_WINDOW_SECONDS=900
# AUTH_RESET_IP_BLOCK_SECONDS=900
# AUTH_RESET_ACCOUNT_MAX_REQUESTS=3
# AUTH_RESET_ACCOUNT_WINDOW_SECONDS=3600
# AUTH_RESET_ACCOUNT_BLOCK_SECONDS=3600

# Read-only Box sharing has no default lifetimes. Keep both unset unless both
# limits have been approved (positive integer seconds). Demo ignores them.
# BOX_SHARING_INVITATION_MAX_LIFETIME_SECONDS=
# BOX_SHARING_ACCESS_MAX_LIFETIME_SECONDS=

# Optional iMinilide cloud settings. On the VM, provision the credentials only
# in the collector's protected systemd environment file, not backend/.env.
# Do not direct credentials to an unapproved URL. See docs/sondes/collecte_iminilide.md.
# IMINILIDE_BASE_URL=https://iminilide.com
# IMINILIDE_EMAIL=
# IMINILIDE_PASSWORD=
# IMINILIDE_TIMEOUT_SECONDS=20
# IMINILIDE_TIME_ZONE=Europe/Paris
# IMINILIDE_MAX_LOOKBACK_DAYS=10
# PROBE_READING_RETENTION_DAYS=14
# PROBE_BUCKET_MINUTES=15
# PROBE_MANUAL_FALLBACK_HOURS=6

# Isolated demo: the entries below are documentation ONLY. Set them in the
# dedicated process environment, never in the ordinary .env. Use
# config.demo_settings; POLYPBASE_DEMO is evaluated before dotenv and demo
# skips dotenv entirely. Remove all PG* variables. The demo uses its fixed
# PostgreSQL socket /run/polypbase-demo/postgresql, not the POSTGRES_* settings.
# POLYPBASE_DEMO=1
# DEMO_PUBLIC_ORIGIN=https://demo.example.invalid
# DEMO_SECRET_KEY=  # Private URL-safe secret, 50-128 characters
# DEMO_DB_NAME=demo_local  # Must start with demo_
# DEMO_DB_USER=demo_local  # Must start with demo_
# DEMO_DB_PASSWORD=  # Private URL-safe password, 32-128 characters

# QA only (process environment, not application defaults): set
# PYTHON_DOTENV_DISABLED=1 to skip dotenv and POLYPBASE_TEST_POSTGRES=0 for
# ordinary SQLite tests. See docs/operations/developpement-qa.md.
