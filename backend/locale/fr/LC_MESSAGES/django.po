#: apps/cultures/services.py apps/cultures/serializers.py apps/cultures/box_codes.py
msgid "The current polyp state changed. Refresh the parent box."
msgstr "Le nombre actuel de polypes a changé. Rechargez la boîte parent."

msgid "The parent box is outside the active organization."
msgstr "La boîte parent n'appartient pas à l'institution active."

msgid "This account cannot create subculture events."
msgstr "Ce compte ne peut pas effectuer de repiquage."

msgid "Only an active box can be subcultured."
msgstr "Seule une boîte active peut être repiquée."

msgid "The parent strain is not eligible for its organization."
msgstr "La souche parent n'est pas autorisée dans cette institution."

msgid "The parent polyp count is unknown."
msgstr "Le nombre de polypes de la boîte parent est inconnu."

msgid "Provide between one and twenty children."
msgstr "Indiquez entre une et vingt boîtes enfants."

msgid "Each child requires a nonnegative integer allocation."
msgstr "Chaque boîte enfant exige un nombre entier de polypes supérieur ou égal à zéro."

msgid "The allocation exceeds the current parent count."
msgstr "La répartition dépasse le nombre actuel de polypes de la boîte parent."

msgid "Each child requires an active zone in the parent organization."
msgstr "Chaque boîte enfant exige un emplacement actif dans l'institution de la boîte parent."

msgid "This field is not accepted for quantitative subculture."
msgstr "Ce champ n'est pas accepté pour un repiquage quantitatif."

msgid "A nonnegative integer is required."
msgstr "Un entier supérieur ou égal à zéro est requis."

msgid "The server records the actual occurrence time."
msgstr "Le serveur enregistre la date et l'heure réelles du repiquage."

msgid "A positive number of box codes is required."
msgstr "Le nombre de codes de boîtes doit être positif."

msgid "The generated box code is too long."
msgstr "Le code de boîte généré est trop long."

