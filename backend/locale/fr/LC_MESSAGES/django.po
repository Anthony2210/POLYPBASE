#: apps/cultures/templates/core/politique_confidentialite.html
msgid "POLYPBASE collecte uniquement les informations nécessaires au suivi des cultures de polypes, à la gestion des comptes utilisateurs et à la traçabilité scientifique des actions réalisées."
msgstr "POLYPBASE collecte uniquement les informations nécessaires au suivi des cultures de polypes, à la gestion des comptes utilisateurs et à la traçabilité scientifique des actions réalisées."

#: apps/cultures/templates/core/politique_confidentialite.html
msgid "Identité de compte : nom complet, adresse email, rôle et organisation."
msgstr "Identité de compte : nom complet, adresse email, rôle et organisation."

#: apps/cultures/templates/core/politique_confidentialite.html
msgid "Données métier : boîtes, espèces, souches, relevés biologiques, salinités, températures et mouvements."
msgstr "Données métier : boîtes, espèces, souches, relevés biologiques, salinités, températures et mouvements."

#: apps/cultures/templates/core/politique_confidentialite.html
msgid "Traçabilité : date, utilisateur et description des créations, modifications, imports, exports et scans."
msgstr "Traçabilité : date, utilisateur et description des créations, modifications, imports, exports et scans."

#: apps/cultures/templates/core/politique_confidentialite.html
msgid "Ces données servent à exécuter le service de suivi de collection, sécuriser l'accès aux informations, produire des exports scientifiques ou réglementaires et conserver l'historique nécessaire à l'exploitation du laboratoire."
msgstr "Ces données servent à exécuter le service de suivi de collection, sécuriser l'accès aux informations, produire des exports scientifiques ou réglementaires et conserver l'historique nécessaire à l'exploitation du laboratoire."

#: apps/cultures/templates/core/politique_confidentialite.html
msgid "Chaque utilisateur peut demander l'accès, la rectification ou la suppression de ses données de compte auprès de l'administrateur de son organisation. Les données scientifiques déjà associées à un historique de laboratoire peuvent être anonymisées lorsque leur suppression compromettrait la traçabilité de la collection."
msgstr "Chaque utilisateur peut demander l'accès, la rectification ou la suppression de ses données de compte auprès de l'administrateur de son organisation. Les données scientifiques déjà associées à un historique de laboratoire peuvent être anonymisées lorsque leur suppression compromettrait la traçabilité de la collection."

#: apps/cultures/templates/core/politique_confidentialite.html
msgid "L'application limite l'accès par compte, rôle et organisation. En production, elle doit être servie en HTTPS, avec des sauvegardes régulières et une base de données non exposée directement aux terminaux du laboratoire."
msgstr "L'application limite l'accès par compte, rôle et organisation. En production, elle doit être servie en HTTPS, avec des sauvegardes régulières et une base de données non exposée directement aux terminaux du laboratoire."

